      "maxDuration": 60,
      "includeFiles": "{app.py,src/**,templates/**,modelos/**,datos/procesado/dataset_modelado_con_clima.csv,datos/procesado/clasificacion_comparacion.csv,datos/procesado/clasificacion_acuerdo_sistemas_test.csv}",
